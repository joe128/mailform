{
    "name": "mailform",
    "private": true,
    "version": "1.1.0",
    "description": "The minimalistic email relay for contact forms and more!",
    "main": "dist/main.js",
    "scripts": {
        "start": "node dist/main.js",
        "build": "tsc && rm -f dist/*.test.js dist/*.spec.js dist/*.test.d.ts dist/*.spec.d.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:ci": "vitest run"
    },
    "keywords": [],
    "author": "Feuerhamster",
    "license": "Apache-2.0",
    "dependencies": {
        "axios": "^1.20.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "formidable": "^3.5.4",
        "nodemailer": "^10.0.9",
        "rate-limiter-flexible": "^11.0.2",
        "validate.js": "^0.13.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/formidable": "^3.5.1",
        "@types/nodemailer": "^8.0.0",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.2.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Feuerhamster/mailform.git"
    },
    "bugs": {
        "url": "https://github.com/Feuerhamster/mailform/issues"
    },
    "homepage": "https://github.com/Feuerhamster/mailform#readme"
}
